{
  "manifest_version": 3,
  "name": "Transcription Extension",
  "version": "0.2.0",
  "description": "Live transcript and translation of YouTube audio using local speech recognition.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "activeTab", "tabCapture", "offscreen"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Transcription Extension",
    "default_popup": "popup.html"
  }
}
